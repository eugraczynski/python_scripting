VERSION "1.0"
NS_ :
    NS_DESC_
    CM_
    BA_DEF_
    BA_
    VAL_
    CAT_DEF_
    CAT_
    FILTER
    BA_DEF_DEF_
    EV_DATA_
    ENVVAR_DATA_
    SGTYPE_
    SGTYPE_VAL_
    BA_DEF_SGTYPE_
    BA_SGTYPE_
    SIG_TYPE_REF_
    VAL_TABLE_
    SIG_GROUP_
    SIG_VALTYPE_
    SIGTYPE_VALTYPE_
    BO_TX_BU_
    BA_DEF_REL_
    BA_REL_
    BA_DEF_DEF_REL_
    BU_SG_REL_
    BU_EV_REL_
    BU_BO_REL_
    SG_MUL_VAL_
BS_:
BU_: SensorManager ActuatorUnit Gateway

BO_ 100 SensorStatus: 8 SensorManager
 SG_ Temperature : 0|16@1+ (0.1,0) [0|150] "C"  SensorManager
 SG_ Pressure : 16|16@1+ (0.01,0) [0|10] "Bar"  SensorManager
 SG_ Humidity : 32|8@1+ (0.5,0) [0|100] "%"  SensorManager

BO_ 200 ControlCommand: 4 Gateway
 SG_ CommandID : 0|8@1+ (1,0) [0|255] ""  Gateway
 SG_ Value : 8|8@1+ (1,0) [0|255] ""  Gateway

BO_ 300 ActuatorFeedback: 8 ActuatorUnit
 SG_ MotorSpeed : 0|16@1+ (0.25,0) [0|8000] "RPM"  ActuatorUnit
 SG_ Torque : 16|16@1+ (0.1,0) [0|500] "Nm"  ActuatorUnit

CM_ "Simple CAN database template";
BA_DEF_  "BusType" STRING ;
BA_ "BusType" "CAN";

VAL_  CommandID  1 "START"  2 "STOP"  3 "RESET"  4 "CALIBRATE" ;